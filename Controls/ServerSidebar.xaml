<UserControl x:Class="MasterShare.Controls.ServerSidebar"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#121214">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="66"/></Grid.RowDefinitions>
  <Border Grid.Row="0" BorderBrush="#292930" BorderThickness="0,0,0,1" Padding="13,10">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
    <Border Width="38" Height="38" CornerRadius="12" Background="#263FA8" VerticalAlignment="Center">
     <TextBlock Text="ϟ" FontSize="23" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
     <TextBlock Text="Game Confidencial" Foreground="#F4F4F5" FontSize="13" FontWeight="Bold"/>
     <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
      <Ellipse Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center"/>
      <TextBlock Text="  3 membros online" Foreground="#A1A1AA" FontSize="10"/>
     </StackPanel>
    </StackPanel>
    <TextBlock Grid.Column="2" Text="⌄" Foreground="#A1A1AA" FontSize="15" VerticalAlignment="Center"/>
   </Grid>
  </Border>
  <TextBlock Grid.Row="1" Text="CANAIS DE TRANSMISSÃO" Foreground="#A1A1AA" FontSize="10" FontWeight="Bold" Margin="16,17,10,9"/>
  <StackPanel Grid.Row="2" x:Name="RoomButtons" Margin="9,0,9,8"/>
  <StackPanel Grid.Row="3" Margin="16,15,12,0">
   <TextBlock Text="USUÁRIOS" Foreground="#A1A1AA" FontSize="10" FontWeight="Bold" Margin="0,0,0,11"/>
   <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
    <Grid Width="32" Height="32">
     <Ellipse Fill="#34527A"/>
     <TextBlock Text="JM" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     <Ellipse Width="9" Height="9" Fill="#10B981" Stroke="#121214" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
    </Grid>
    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
     <TextBlock Text="JamesMaster  ♛" Foreground="#E4E4E7" FontSize="12" FontWeight="SemiBold"/>
     <TextBlock Text="Transmitindo" Foreground="#F87171" FontSize="10"/>
    </StackPanel>
   </StackPanel>
   <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
    <Grid Width="32" Height="32"><Ellipse Fill="#46566B"/><TextBlock Text="MK" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse Width="9" Height="9" Fill="#10B981" Stroke="#121214" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid>
    <TextBlock Text="Mikael" Foreground="#D4D4D8" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" Margin="9,0"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
    <Grid Width="32" Height="32"><Ellipse Fill="#6A4C65"/><TextBlock Text="TH" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse Width="9" Height="9" Fill="#10B981" Stroke="#121214" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid>
    <TextBlock Text="ThaisGamer" Foreground="#D4D4D8" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" Margin="9,0"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
    <Grid Width="32" Height="32"><Ellipse Fill="#4B5563"/><TextBlock Text="LR" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse Width="9" Height="9" Fill="#71717A" Stroke="#121214" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid>
    <TextBlock Text="LucasBR" Foreground="#A1A1AA" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" Margin="9,0"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal">
    <Grid Width="32" Height="32"><Ellipse Fill="#665D4B"/><TextBlock Text="RF" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse Width="9" Height="9" Fill="#71717A" Stroke="#121214" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid>
    <TextBlock Text="RenatoFPS" Foreground="#A1A1AA" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" Margin="9,0"/>
   </StackPanel>
  </StackPanel>
  <Border Grid.Row="4" Background="#0D0D0F" BorderBrush="#292930" BorderThickness="0,1,0,0" Padding="13,8">
   <DockPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,9,0">
      <Border Width="4" Height="9" Background="#10B981" CornerRadius="2" Margin="0,0,3,0"/>
      <Border Width="4" Height="13" Background="#10B981" CornerRadius="2" Margin="0,0,3,0"/>
      <Border Width="4" Height="17" Background="#10B981" CornerRadius="2"/>
     </StackPanel>
     <StackPanel>
      <TextBlock Text="Conectado" Foreground="#34D399" FontSize="11" FontWeight="Bold"/>
      <TextBlock Text="Geral • Game Confidencial" Foreground="#A1A1AA" FontSize="9"/>
     </StackPanel>
    </StackPanel>
    <Button DockPanel.Dock="Right" Content="⚙" FontSize="15" Padding="7,3" ToolTip="Configurações" Click="Settings_Click"/>
   </DockPanel>
  </Border>
 </Grid>
</UserControl>