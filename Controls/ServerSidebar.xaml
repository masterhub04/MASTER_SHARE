<UserControl x:Class="MasterShare.Controls.ServerSidebar"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{StaticResource SidebarBrush}">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="108"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="76"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="18,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
   <Border Width="48" Height="48" CornerRadius="14" Background="#252D3B" VerticalAlignment="Center">
    <TextBlock Text="M" FontSize="29" FontWeight="Bold" Foreground="#1685FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Border>
   <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
    <TextBlock Text="Minha comunidade" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
     <Ellipse Width="7" Height="7" Fill="#23C76A" VerticalAlignment="Center"/>
     <TextBlock Text="  1 membro online" Foreground="#A5ADBD" FontSize="11"/>
    </StackPanel>
   </StackPanel>
   <TextBlock Grid.Column="2" Text="⌄" Foreground="#A5ADBD" FontSize="17" VerticalAlignment="Center"/>
  </Grid>
  <TextBlock Grid.Row="1" Text="CANAIS DE TRANSMISSÃO" Foreground="#8791A2" FontSize="10" FontWeight="SemiBold" Margin="18,6,10,8"/>
  <StackPanel Grid.Row="2" x:Name="RoomButtons" Margin="9,0,9,12"/>
  <StackPanel Grid.Row="3" Margin="18,8,12,0">
   <TextBlock Text="USUÁRIOS" Foreground="#8791A2" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,12"/>
   <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
    <Border Width="31" Height="31" CornerRadius="16" Background="#315078">
     <TextBlock Text="JM" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
     <TextBlock Text="Você" Foreground="#E8EBF2" FontSize="12" FontWeight="Medium"/>
     <TextBlock Text="Online" Foreground="#23C76A" FontSize="10"/>
    </StackPanel>
   </StackPanel>
   <TextBlock Text="Os participantes conectados aparecerão aqui." Foreground="#788294" FontSize="11" TextWrapping="Wrap" Margin="0,6,8,0"/>
  </StackPanel>
  <Border Grid.Row="4" Background="#171A22" Padding="15,10">
   <DockPanel>
    <Ellipse Width="9" Height="9" Fill="#23C76A" VerticalAlignment="Center"/>
    <StackPanel Margin="9,0,0,0">
     <TextBlock Text="Aplicativo iniciado" Foreground="#23C76A" FontSize="11" FontWeight="SemiBold"/>
     <TextBlock Text="Ainda não conectado" Foreground="#8993A4" FontSize="10"/>
    </StackPanel>
    <Button DockPanel.Dock="Right" Content="⚙" FontSize="17" Padding="8,4" ToolTip="Configurações" Click="Settings_Click"/>
   </DockPanel>
  </Border>
 </Grid>
</UserControl>
