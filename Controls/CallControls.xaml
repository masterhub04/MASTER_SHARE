<UserControl x:Class="MasterShare.Controls.CallControls"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#0B0B0D">
 <Grid>
  <Border Background="#E6121214" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="15" Padding="10,7" HorizontalAlignment="Center" VerticalAlignment="Center">
   <StackPanel Orientation="Horizontal">
    <Button x:Name="MicButton" Width="43" Height="42" Margin="3,0" Background="#29292F" Content="🎙" FontSize="15" Click="Mic_Click" ToolTip="Microfone"/>
    <Button Width="43" Height="42" Margin="3,0" Background="#29292F" Content="▣" FontSize="17" Click="Settings_Click" ToolTip="Câmera"/>
    <Button Width="48" Height="42" Margin="3,0" Background="#DC2626" Content="☎" FontSize="17" Click="Leave_Click" ToolTip="Desconectar"/>
    <Button Width="43" Height="42" Margin="3,0" Background="#29292F" Content="▣" FontSize="17" Click="Share_Click" ToolTip="Compartilhar tela"/>
    <Button Width="43" Height="42" Margin="3,0" Background="#29292F" Content="•••" FontSize="15" Click="Settings_Click" ToolTip="Mais opções"/>
   </StackPanel>
  </Border>
  <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0" Width="39" Height="39" Background="#E6121214" BorderBrush="#33FFFFFF" BorderThickness="1" Content="⛶" FontSize="15" Click="Fullscreen_Click" ToolTip="Tela cheia"/>
 </Grid>
</UserControl>