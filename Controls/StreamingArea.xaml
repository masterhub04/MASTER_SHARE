<UserControl x:Class="MasterShare.Controls.StreamingArea"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{StaticResource BackgroundBrush}">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#171B24" BorderBrush="#2B3240" BorderThickness="1" CornerRadius="9">
   <Grid>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
     <Border Width="58" Height="58" CornerRadius="18" Background="#222B3A" HorizontalAlignment="Center" Margin="0,0,0,16">
      <TextBlock Text="▣" FontSize="27" Foreground="#8FA0B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <TextBlock Text="Nenhuma transmissão ativa" Foreground="#E8EBF2" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
     <TextBlock Text="Quando alguém compartilhar a tela nesta sala, a transmissão aparecerá aqui."
                Foreground="#929CAD" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>
    <Border Background="#222B39" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14">
     <TextBlock Text="AGUARDANDO TRANSMISSÃO" Foreground="#AEB8C8" FontSize="9" FontWeight="SemiBold" Margin="10,6"/>
    </Border>
   </Grid>
  </Border>
  <TextBlock Grid.Row="1" Text="A transmissão de vídeo será exibida nesta área quando o mecanismo de captura estiver conectado."
             Foreground="#697486" FontSize="10" Margin="2,12,0,0"/>
 </Grid>
</UserControl>
