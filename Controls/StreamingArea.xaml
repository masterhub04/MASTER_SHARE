<UserControl x:Class="MasterShare.Controls.StreamingArea"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#0B0B0D">
 <Grid Margin="20,18,20,12">
  <Border Background="#050507" BorderBrush="#303038" BorderThickness="1" CornerRadius="13" ClipToBounds="True">
   <Grid>
    <Image Source="https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&amp;fit=crop&amp;w=1920&amp;q=80" Stretch="UniformToFill" Opacity="0.82"/>
    <Rectangle>
     <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#22000000" Offset="0"/><GradientStop Color="#99000000" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
    </Rectangle>
    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18">
     <StackPanel Margin="0,0,0,15" Width="64">
      <Border Width="38" Height="38" CornerRadius="8" Background="#CC2563EB" HorizontalAlignment="Center"><TextBlock Text="▣" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <TextBlock Text="Este Computador" Foreground="White" FontSize="9" TextAlignment="Center" Margin="0,4,0,0"/>
     </StackPanel>
     <StackPanel Width="64">
      <Border Width="38" Height="38" CornerRadius="8" Background="#AA52525B" HorizontalAlignment="Center"><TextBlock Text="▤" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <TextBlock Text="Lixeira" Foreground="White" FontSize="9" TextAlignment="Center" Margin="0,4,0,0"/>
     </StackPanel>
    </StackPanel>
    <Border Background="#FFDC2626" CornerRadius="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" Padding="10,5">
     <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="White" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="AO VIVO" Foreground="White" FontSize="10" FontWeight="Bold"/></StackPanel>
    </Border>
    <Border Background="#99000000" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="9" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16" Padding="9,6">
     <StackPanel Orientation="Horizontal">
      <Ellipse Width="24" Height="24" Fill="#34527A" Margin="0,0,8,0"/>
      <TextBlock Text="JamesMaster" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
     </StackPanel>
    </Border>
    <Border Background="#77000000" CornerRadius="7" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14" Padding="9,5">
     <TextBlock Text="⌃   ◈   02:45  |  31/10/2026" Foreground="#E4E4E7" FontSize="9"/>
    </Border>
   </Grid>
  </Border>
 </Grid>
</UserControl>