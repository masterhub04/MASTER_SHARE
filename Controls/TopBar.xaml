<UserControl x:Class="MasterShare.Controls.TopBar"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#151820">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
   <Border Width="27" Height="27" CornerRadius="7" Background="#1685FF" Margin="0,0,10,0">
    <TextBlock Text="M" FontSize="19" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Border>
   <TextBlock Text="MASTER SHARE" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
   <TextBlock Text="  •  0.1.0" FontSize="11" Foreground="#7E8798" VerticalAlignment="Center" Margin="8,0,0,0"/>
  </StackPanel>
  <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button x:Name="MinButton" Content="—" Width="48" FontSize="16" Click="Min_Click"/>
   <Button x:Name="MaxButton" Content="□" Width="48" FontSize="15" Click="Max_Click"/>
   <Button Content="✕" Width="48" FontSize="16" Click="Close_Click"/>
  </StackPanel>
 </Grid>
</UserControl>
