<UserControl x:Class="MasterShare.Controls.TopBar"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#0E0E10">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="144"/></Grid.ColumnDefinitions>
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
   <Border Width="20" Height="20" CornerRadius="5" Background="#2563EB" Margin="0,0,9,0">
    <TextBlock Text="M" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Border>
   <TextBlock Text="MASTER SHARE" FontSize="11" FontWeight="SemiBold" Foreground="#E4E4E7" VerticalAlignment="Center"/>
  </StackPanel>
  <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="—" Width="46" Height="35" FontSize="12" Foreground="#A1A1AA" Click="Min_Click"/>
   <Button Content="□" Width="46" Height="35" FontSize="11" Foreground="#A1A1AA" Click="Max_Click"/>
   <Button Content="✕" Width="46" Height="35" FontSize="13" Foreground="#A1A1AA" Click="Close_Click"/>
  </StackPanel>
 </Grid>
</UserControl>