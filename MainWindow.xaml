<Window x:Class="MasterShare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MasterShare.Controls"
        Title="MASTER SHARE" Width="1440" Height="900" MinWidth="1050" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}">
    <Border BorderBrush="#292930" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <controls:TopBar Grid.Row="0" x:Name="TopBar"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="256" MinWidth="230"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <controls:ServerSidebar Grid.Column="0" x:Name="ServerSidebar"/>
                <Grid Grid.Column="1" Background="{StaticResource BackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="82"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#0B0B0D" BorderBrush="#292930" BorderThickness="0,0,0,1" Padding="24,0">
                        <DockPanel VerticalAlignment="Center">
                            <TextBlock Text="◖" FontSize="17" Foreground="#A1A1AA" Margin="0,0,12,0"/>
                            <TextBlock x:Name="RoomTitle" Text="Geral" FontSize="14" FontWeight="Bold" Foreground="#E4E4E7"/>
                            <TextBlock x:Name="ViewerCount" Text="  |  2 assistindo" FontSize="12" Foreground="#A1A1AA"/>
                        </DockPanel>
                    </Border>
                    <controls:StreamingArea Grid.Row="1" x:Name="StreamingArea"/>
                    <controls:CallControls Grid.Row="2" x:Name="CallControls"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>