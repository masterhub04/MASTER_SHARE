<Window x:Class="MasterShare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MasterShare.Controls"
        Title="MASTER SHARE" Width="1440" Height="860" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}">
    <Border BorderBrush="#303643" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <controls:TopBar Grid.Row="0" x:Name="TopBar"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="246" MinWidth="210"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <controls:ServerSidebar Grid.Column="0" x:Name="ServerSidebar"/>
                <Grid Grid.Column="1" Background="{StaticResource BackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="76"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="#292E39" BorderThickness="0,0,0,1" Padding="24,0">
                        <DockPanel LastChildFill="True" VerticalAlignment="Center">
                            <TextBlock Text="◖" FontSize="20" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RoomTitle" Text="Geral" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ViewerCount" Text="  •  1 participante" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Conexão privada" DockPanel.Dock="Right" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <controls:StreamingArea Grid.Row="1" x:Name="StreamingArea"/>
                    <controls:CallControls Grid.Row="2" x:Name="CallControls"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
